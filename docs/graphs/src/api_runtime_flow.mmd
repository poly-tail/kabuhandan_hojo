flowchart TD
    start["User runs API command"]
    runner["scripts/run_api.py"]
    parse["parse_args()"]
    branch{"--mock specified?"}
    mockEnv["set APP_USE_MOCK=true"]
    clear["clear settings / engine caches"]
    uvicorn["uvicorn factory run"]
    create["app.main:create_app()"]
    lifespan{"startup mode"}
    liveInit["init_db() creates tables"]
    mockInit["init_db() skipped"]
    health["GET /health"]
    watchlist["GET or POST /watchlist"]
    monitoring["GET /dashboard or /screening"]
    ui["GET /ui/dashboard"]
    healthLive["DB session + SELECT 1\nresponse.database = ok"]
    healthMock["no DB access\nresponse.database = mock"]
    watchLive["WatchlistService + SQLAlchemy"]
    watchMock["MockWatchlistService + in-memory sample data"]
    monitoringLive["Security / Watchlist services + SQLAlchemy"]
    monitoringMock["MockMonitoringService + stable sample signals"]
    uiShell["HTML shell fetches\n/health /watchlist /dashboard /screening"]
    analysisUi["GET /ui/analysis\nselect one security + question"]
    analysisPost["POST /api/ai/analyses"]
    promptCompiler["IndividualSecurityPromptCompiler\nv2026.08.17 + module 3.1"]
    openai["OpenAI Responses API\ngpt-5.6-terra / STANDARD"]
    validate["completed + response ID\nnon-empty output_text"]
    save["transaction save\nai_analysis_record"]
    answer["plain answer + saved request_id"]
    reader["GET /ui/analysis/results/{request_id}"]
    savedGet["GET /api/ai/analyses/{request_id}"]
    savedAnswer["saved question + answer\ntextContent / pre-wrap"]
    analysisError["typed error\nno mock/cache/fallback"]

    start --> runner
    runner --> parse
    parse --> branch
    branch -->|yes| mockEnv
    branch -->|no| clear
    mockEnv --> clear
    clear --> uvicorn
    uvicorn --> create
    create --> lifespan
    lifespan -->|live| liveInit
    lifespan -->|mock| mockInit
    liveInit --> health
    liveInit --> watchlist
    liveInit --> monitoring
    liveInit --> ui
    liveInit --> analysisUi
    mockInit --> health
    mockInit --> watchlist
    mockInit --> monitoring
    mockInit --> ui
    health --> healthLive
    health --> healthMock
    watchlist --> watchLive
    watchlist --> watchMock
    monitoring --> monitoringLive
    monitoring --> monitoringMock
    ui --> uiShell
    analysisUi --> analysisPost
    analysisPost --> promptCompiler
    promptCompiler --> openai
    openai --> validate
    validate -->|valid| save
    validate -->|invalid/error| analysisError
    save -->|commit| answer
    save -->|rollback| analysisError
    answer --> reader
    reader --> savedGet
    savedGet --> savedAnswer
