APP_NAME=Kabuhandan Hojo API
APP_ENV=local
APP_VERSION=0.1.0
APP_USE_MOCK=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/kabuhandan_hojo.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_MODEL_SCANNER=gpt-5.4
OPENAI_MODEL_ANALYST=gpt-5.4
OPENAI_MODEL_JUDGE=gpt-5.5
OPENAI_MODEL_CRITICAL=gpt-5.5
OPENAI_REASONING_SCANNER=low
OPENAI_REASONING_ANALYST=medium
OPENAI_REASONING_JUDGE=high
OPENAI_REASONING_CRITICAL=xhigh
OPENAI_ENABLE_WEB_SEARCH=true
OPENAI_MAX_WEB_SEARCH_CALLS=5
OPENAI_MAX_STOCKS_PER_REQUEST=20
OPENAI_DAILY_REQUEST_LIMIT=300
OPENAI_DEFAULT_VERBOSITY=medium
OPENAI_CRITICAL_CONFIRMATION_REQUIRED=true
JQUANTS_API_KEY=
JQUANTS_BASE_URL=https://api.jquants.com
TDNET_API_KEY=
TDNET_BASE_URL=https://api.arrowfront.jp
EDINET_API_KEY=
EDINET_BASE_URL=https://api.edinet-fsa.go.jp/api/v2
YOUTUBE_API_KEY=
IR_ALLOWLIST_DOMAINS=[]
SCORING_EVENT_WEIGHT=0.30
SCORING_FUNDAMENTAL_WEIGHT=0.25
SCORING_TECHNICAL_WEIGHT=0.20
SCORING_FLOW_WEIGHT=0.15
SCORING_RISK_WEIGHT=0.10
SCORE_CHANGE_ALERT_THRESHOLD=12.0
HIGH_PRIORITY_THRESHOLD=65.0
LOW_LIQUIDITY_DAILY_VOLUME=100000
RECENT_EVENT_LOOKBACK_DAYS=30

POSTGRES_USER=kabuhandan
POSTGRES_PASSWORD=kabuhandan
POSTGRES_DB=kabuhandan
POSTGRES_HOST=db
POSTGRES_PORT=5432
